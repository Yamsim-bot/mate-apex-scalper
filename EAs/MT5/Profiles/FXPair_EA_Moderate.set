; FXPair_EA Moderate — RiskPerTradePct=0.5, Min_RR=1.2, EA defaults
; Scope: EURUSD+ only (SymbolList kept at default), US30 out of scope. Sessions in PH (UTC+8), EA defaults:
; London 15-00 PH (= 07-16 UTC) / NY 20-05 PH (covers 16-21 UTC). UseSessionFilter=false is the EA default.
; NOTE: EA has NO MaxPositions input — uses MaxPositionsPerPair + MaxGlobalPositions. No ScalpMode / trend-filter bool.
SymbolList=EURUSD+
RiskPerTradePct=0.5
MaxDailyLossPct=5.0
MaxPositionsPerPair=2
MaxGlobalPositions=6
MaxDailyTrades=30
MaxTPHits=5
Min_RR=1.2
TP_Mode=1
TP_ATR_Mult=1.5
ConfluenceMinScore=1
UseSessionFilter=false
SessionStartHour=15
SessionStartMin=0
SessionEndHour=0
SessionEndMin=0
Session2StartHour=20
Session2StartMin=0
Session2EndHour=5
Session2EndMin=0
UseTrailing=true
UseBreakEven=true
MagicNumber=20260723
CommentPrefix=PAIR_EA
