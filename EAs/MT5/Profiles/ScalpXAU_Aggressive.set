; ScalpXAU Aggressive — RiskPerTradePct=1.0, wide sessions, filters relaxed, VP-Pro ON (scalp proxy)
; Scope: XAU/XAG + EURUSD+ only, US30 out of scope. Sessions in GMT (=UTC).
; London 07-11 GMT / NY 13-17 GMT (wide). No ScalpMode input exists — EnableVPPro used as scalp proxy.
; NOTE: ScalpXAU has NO MinRR input — RR floor is hardcoded 2.0 in code. No MinRR line possible.
RiskPerTradePct=1.0
MaxDailyRiskPct=4.0
MaxSessDDPct=2.0
MaxTradesPerSess=8
MaxPositions=2
EnableTrendFilter=false
PA_RequireTrend=false
EnableSR=true
EnableAsiaVP=true
AsiaVP_MinRangeATR=1.5
AsiaVP_UseFlow=false
AsiaVP_FlowWinMin=20
EnableVPPro=true
VPPro_MinSDStr=2.0
VPPro_ZoneTolATR=0.6
VPPro_RequireFlow=false
VPPro_FlowWinMin=20
VPPro_FlowThresh=0.50
Asian_StartH=0
Asian_StartM=30
Asian_EndH=3
Asian_EndM=30
London_StartH=7
London_StartM=0
London_EndH=11
London_EndM=0
NY_StartH=13
NY_StartM=0
NY_EndH=17
NY_EndM=0
UseBreakEven=true
UseTrailing=true
MagicNumber=241107
CommentPrefix=SCALPX_EA
