SL_ATR=1.2
TP_ATR=2.0
MinRR=1.2
UseBE=true
BE_TriggerATR=0.8
UseTrail=true
TrailStartATR=1.0
TrailStepATR=0.3
EnableDeltaBubble=true
LondonStart=7
LondonEnd=10
NYStart=13
NYEnd=16
MagicNumber=334455
CommentPrefix=SCALP
