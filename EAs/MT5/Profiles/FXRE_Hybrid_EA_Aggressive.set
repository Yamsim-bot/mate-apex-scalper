ResetOnNewSession=true
Min_RR=1.0
TP_Multiplier=1.2
ScalpMode=true
UseTrendFilter=false
UseSessionFilter=false
SessionStartHour=14
SessionStartMin=0
SessionEndHour=1
SessionEndMin=0
Session2StartHour=19
Session2StartMin=0
Session2EndHour=6
Session2EndMin=0
UsePartialTP=true
UseTrailing=true
UseBreakEven=true
MagicNumber=20241201
CommentPrefix=FXRE_HYBRID
