<?xml version="1.0" encoding="UTF-8"?>
<profile>
 <expert name="ScalpXAU">
  <group name="GENERAL">
   <property id="0" name="Inp_Gen">======== GENERAL ========</property>
   <property id="1" name="RiskPerTradePct">0.5</property>
   <property id="2" name="MaxDailyRiskPct">2.0</property>
   <property id="3" name="MaxSessDDPct">1.5</property>
   <property id="4" name="MaxTradesPerSess">5</property>
   <property id="5" name="MaxPositions">1</property>
   <property id="6" name="BrokerGMTOffset">-99</property>
   <property id="7" name="DebugMode">false</property>
  </group>
  <group name="TIMEFRAMES">
   <property id="8" name="Inp_TF">======= TIMEFRAMES =======</property>
   <property id="9" name="EntryTF">0</property>
   <property id="10" name="ProfileTF">0</property>
   <property id="11" name="SwingLookback">100</property>
  </group>
  <group name="FRVP SETTINGS">
   <property id="12" name="Inp_FRVP">===== FRVP SETTINGS ======</property>
   <property id="13" name="FRVP_Anchors">48</property>
   <property id="14" name="FRVP_BucketPips">0.5</property>
   <property id="15" name="FRVP_ValueAreaPct">70.0</property>
   <property id="16" name="FRVP_HVNThreshold">0.7</property>
   <property id="17" name="FRVP_LVNThreshold">0.2</property>
   <property id="18" name="FRVP_ZoneTolATR">0.3</property>
   <property id="19" name="FRVP_RefreshBars">6</property>
  </group>
  <group name="PRICE ACTION">
   <property id="20" name="Inp_PA">===== PRICE ACTION ======</property>
   <property id="21" name="PA_MinWickATR">0.5</property>
   <property id="22" name="PA_WickBodyRatio">2.0</property>
   <property id="23" name="PA_MinBodyATR">0.15</property>
   <property id="24" name="PA_MinMoveATR">1.0</property>
   <property id="25" name="PA_RequireTrend">true</property>
  </group>
  <group name="TREND FILTER">
   <property id="26" name="Inp_Trend">===== TREND FILTER ======</property>
   <property id="27" name="EnableTrendFilter">true</property>
   <property id="28" name="Trend_MA_Fast">50</property>
   <property id="29" name="Trend_MA_Slow">200</property>
  </group>
  <group name="RISK MGMT">
   <property id="30" name="Inp_RM">===== RISK MGMT ======</property>
   <property id="31" name="UseBreakEven">true</property>
   <property id="32" name="BE_ATR_Mult">0.6</property>
   <property id="33" name="UseTrailing">true</property>
   <property id="34" name="TrailStart_ATR">0.8</property>
   <property id="35" name="TrailStep_ATR">0.3</property>
   <property id="36" name="MaxSlippagePts">30</property>
   <property id="37" name="Min_SL_ATR">1.0</property>
   <property id="38" name="MagicNumber">241107</property>
   <property id="39" name="CommentPrefix">SCALPX_EA</property>
  </group>
  <group name="S/R SETTINGS">
   <property id="40" name="Inp_SR">===== S/R SETTINGS ======</property>
   <property id="41" name="EnableSR">true</property>
   <property id="42" name="SR_ZoneATR">0.5</property>
   <property id="43" name="SR_SwingLen">2</property>
   <property id="44" name="SR_ScoreSupport">2</property>
   <property id="45" name="SR_ScoreResistance">2</property>
   <property id="46" name="SR_ScoreMTF">1</property>
  </group>
  <group name="ASIA VP MODE">
   <property id="47" name="Inp_AsiaVP">==== ASIA VP MODE ======</property>
   <property id="48" name="EnableAsiaVP">false</property>
   <property id="49" name="AsiaVP_MinRangeATR">2.0</property>
   <property id="50" name="AsiaVP_UseFlow">true</property>
   <property id="51" name="AsiaVP_FlowWinMin">20</property>
  </group>
  <group name="VP-PRO MODE">
   <property id="52" name="Inp_VPPro">==== VP-PRO MODE ======</property>
   <property id="53" name="EnableVPPro">true</property>
   <property id="54" name="VPPro_BucketPips">0.5</property>
   <property id="55" name="VPPro_VAAPct">70.0</property>
   <property id="56" name="VPPro_RefreshBars">12</property>
   <property id="57" name="VPPro_ZoneTolATR">0.4</property>
   <property id="58" name="VPPro_MinSDStr">3.0</property>
   <property id="59" name="VPPro_SDProxATR">2.0</property>
   <property id="60" name="VPPro_RequireFlow">true</property>
   <property id="61" name="VPPro_FlowWinMin">20</property>
   <property id="62" name="VPPro_FlowThresh">0.55</property>
  </group>
  <group name="SESSION GMT TIMES">
   <property id="63" name="Inp_Time">====== SESSION GMT TIMES ====</property>
   <property id="64" name="Asian_StartH">0</property>
   <property id="65" name="Asian_StartM">30</property>
   <property id="66" name="Asian_EndH">3</property>
   <property id="67" name="Asian_EndM">30</property>
   <property id="68" name="London_StartH">7</property>
   <property id="69" name="London_StartM">0</property>
   <property id="70" name="London_EndH">10</property>
   <property id="71" name="London_EndM">0</property>
   <property id="72" name="NY_StartH">13</property>
   <property id="73" name="NY_StartM">30</property>
   <property id="74" name="NY_EndH">16</property>
   <property id="75" name="NY_EndM">30</property>
  </group>
 </expert>
</profile>
