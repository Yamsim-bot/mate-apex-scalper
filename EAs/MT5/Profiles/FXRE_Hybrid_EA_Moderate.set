MaxDailyLossPct=3.0
MaxPositions=2
MaxDailyTrades=15
MaxTPHits=5
ResetOnNewSession=true
Min_RR=1.2
TP_Multiplier=1.5
ScalpMode=true
UseTrendFilter=false
UseSessionFilter=false
SessionStartHour=15
SessionStartMin=0
SessionEndHour=0
SessionEndMin=0
Session2StartHour=20
Session2StartMin=0
Session2EndHour=5
Session2EndMin=0
UsePartialTP=true
UseTrailing=true
UseBreakEven=true
MagicNumber=20241201
CommentPrefix=FXRE_HYBRID
