; ScalpXAU Moderate — RiskPerTradePct=0.5, defaults (VP-Pro ON per base set)
; Scope: XAU/XAG + EURUSD+ only, US30 out of scope. Sessions in GMT (=UTC).
; London 07-10 GMT / NY 13:30-16:30 GMT (EA defaults)
; NOTE: ScalpXAU has NO MinRR input — RR floor is hardcoded 2.0 in code. No MinRR line possible.
RiskPerTradePct=0.5
MaxDailyRiskPct=2.0
MaxSessDDPct=1.5
MaxTradesPerSess=5
MaxPositions=1
EnableTrendFilter=true
PA_RequireTrend=true
EnableSR=true
EnableAsiaVP=true
AsiaVP_MinRangeATR=2.0
AsiaVP_UseFlow=true
AsiaVP_FlowWinMin=20
EnableVPPro=true
VPPro_MinSDStr=2.0
VPPro_ZoneTolATR=0.6
VPPro_RequireFlow=true
VPPro_FlowWinMin=20
VPPro_FlowThresh=0.50
Asian_StartH=0
Asian_StartM=30
Asian_EndH=3
Asian_EndM=30
London_StartH=7
London_StartM=0
London_EndH=10
London_EndM=0
NY_StartH=13
NY_StartM=30
NY_EndH=16
NY_EndM=30
UseBreakEven=true
UseTrailing=true
MagicNumber=241107
CommentPrefix=SCALPX_EA
